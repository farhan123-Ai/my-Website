# Copy this file to .env.local and fill values from Firebase Console > Project settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# The email allowed to initialize the first admin account (must match firestore.rules)
VITE_BOOTSTRAP_ADMIN_EMAIL=bootstrap-admin@example.com
